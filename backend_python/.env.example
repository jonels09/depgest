# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Model Training Parameters
XGBOOST_TEST_SIZE=0.2
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_N_ESTIMATORS=100

PROPHET_YEARLY_SEASONALITY=True
PROPHET_WEEKLY_SEASONALITY=True
PROPHET_DAILY_SEASONALITY=False
PROPHET_INTERVAL_WIDTH=0.95

# Anomaly Detection Parameters
ANOMALY_ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_ZSCORE_THRESHOLD=2.5
ANOMALY_MIN_HISTORY_DAYS=30

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC
SCHEDULER_RETRAIN_HOUR=2
SCHEDULER_RETRAIN_DAY_OF_WEEK=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_XGBOOST=True
ENABLE_PROPHET=True
ENABLE_ANOMALY_DETECTION=True
ENABLE_SCORE_CALCULATION=True
ENABLE_AUTO_RETRAINING=True
